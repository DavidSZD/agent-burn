{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Agent Burn",
	"version": "20.0.20",
	"identifier": "dev.melvynx.agent-burn-windows",
	"build": {
		"frontendDist": "./ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Agent Burn",
				"width": 1060,
				"height": 780,
				"resizable": true,
				"fullscreen": false,
				"visible": true,
				"center": true,
				"decorations": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/icon.ico",
			"icons/icon.png"
		]
	}
}
